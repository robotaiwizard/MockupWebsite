# Settings for Unleash Athens. In production, enter these as environment variables in
# Hostinger hPanel. Locally, copy this file to .env (git-ignored) and fill it in.
# Never commit real passwords or keys.

# --- General ---------------------------------------------------------------
NODE_ENV=production
# Public address of the site (used in emails, Stripe redirects and sign-in links)
BASE_URL=https://unleashathens.com

# --- Database (MySQL / MariaDB from hPanel → Databases) -----------------------
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Email (Hostinger mailbox) -------------------------------------------------
# Booking notifications go to this address
BOOKING_EMAIL_TO=info@unleashathens.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@unleashathens.com
SMTP_PASS=

# --- Payments (Stripe Dashboard → Developers) ----------------------------------
# Use sk_test_… keys until you're ready, then switch to sk_live_…
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<your-domain>/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# --- Policies (optional) --------------------------------------------------------
# Days before arrival that guests can still cancel online for a full refund
FREE_CANCELLATION_DAYS=7
# Years booking records are kept after the stay (confirm with your accountant)
RETENTION_YEARS=6
