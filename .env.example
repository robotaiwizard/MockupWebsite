# Copy to .env and fill in. .env is git-ignored; never commit real passwords.
# Booking requests from the website are emailed to this address.
BOOKING_EMAIL_TO=info@unleashathens.com

# SMTP account used to send the emails (from your email provider).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@unleashathens.com
SMTP_PASS=
MAIL_FROM="Unleash Athens website <no-reply@unleashathens.com>"
